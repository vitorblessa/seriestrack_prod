# Copy this file to `.env` for local dev, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, etc).
# Never commit a real `.env` file — it's already git-ignored.

APP_ENV=production

# MongoDB connection string. Free option: MongoDB Atlas (M0 cluster).
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=seriestrack

# Any long random string. On Render, `generateValue: true` in render.yaml
# creates this for you automatically.
JWT_SECRET=change-me-to-a-long-random-string

# TMDB API — themoviedb.org/settings/api (use the "API Read Access Token", v4 auth)
TMDB_READ_TOKEN=
TMDB_REGION=BR
TMDB_LANG=pt-BR

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://seriestrack.vercel.app
CORS_ORIGINS=

# First admin account, seeded on backend startup if it doesn't exist yet.
ADMIN_EMAIL=admin@seriestrack.app
ADMIN_PASSWORD=

# Optional: comma-separated emails that get Pro access without paying.
PRO_OWNERS=

# Stripe (dashboard.stripe.com/apikeys). Use test-mode keys (sk_test_/pk_test_)
# until you're ready to charge real cards.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# Web Push (VAPID). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Public key goes here as-is. Private key must be saved as a .pem file on the
# server; this variable points to that file's path (Render: upload it as a
# "Secret File" and paste the path Render gives you, e.g. /etc/secrets/vapid_private.pem).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM_PATH=
VAPID_SUBJECT=mailto:admin@seriestrack.app
