# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android — never commit build outputs or signing material.
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/app/release/
/android/app/debug/
*.jks
*.keystore
*.pem
*.p12
release-key.properties
# google-services.json IS committed (see android/app/ directly) — it's the
# Firebase Android client config (project id + a client-scoped API key), not
# a server secret; Google's own docs say it's fine in source control, and
# the android-release.yml CI build needs it present in the checkout. The
# real secret (the Admin SDK service-account key, used server-side) is
# FIREBASE_SERVICE_ACCOUNT_JSON — that one is a Render env var only.
