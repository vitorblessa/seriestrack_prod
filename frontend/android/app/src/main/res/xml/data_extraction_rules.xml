<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules — we opt OUT of auto-backup entirely.
    Sensitive data (JWT tokens, session cookies, cached user data) should never
    be shipped to Google Drive backups without an explicit user gesture.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
